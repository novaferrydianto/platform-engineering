# Copy to backend.tf AFTER the first apply, fill in the bucket the apply printed,
# then run: tofu init -migrate-state
#
# backend.tf itself is gitignored across this repo, so this .example file is what
# gets committed.

terraform {
  backend "gcs" {
    bucket = "REPLACE_WITH_BUCKET_NAME"
    prefix = "bootstrap"
  }
}

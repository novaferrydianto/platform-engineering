# Copy to backend.tf AFTER the first apply, fill in the values the apply printed,
# then run: tofu init -migrate-state
#
# backend.tf itself is gitignored across this repo (Terragrunt generates it for
# units under provisioning/live/), so this .example file is what gets committed.

terraform {
  backend "s3" {
    bucket = "REPLACE_WITH_BUCKET_NAME"
    key    = "bootstrap/tofu.tfstate"
    region = "REPLACE_WITH_REGION"

    encrypt    = true
    kms_key_id = "REPLACE_WITH_KMS_KEY_ARN"

    # Native S3 locking (OpenTofu 1.10+). No DynamoDB table required.
    use_lockfile = true
  }
}
